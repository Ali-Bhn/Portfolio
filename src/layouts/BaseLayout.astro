---
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const { title, description, image, type, structuredData, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo title={title} description={description} image={image} type={type} structuredData={structuredData} />
  </head>
  <body class={bodyClass}>
    <div class="background-glow" aria-hidden="true"></div>

    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <script src="../scripts/nav.js"></script>
    <script src="../scripts/glow.js"></script>
  </body>
</html>
