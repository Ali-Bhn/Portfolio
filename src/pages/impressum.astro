---
import Seo from "../components/Seo.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo title="Impressum | Ali Bahadoran" description="Impressum von Ali Bahadoran gemäß § 5 DDG." />
  </head>
  <body class="legal-page">
    <header class="legal-header">
      <nav class="legal-navigation container" aria-label="Seitennavigation">
        <a class="logo" href="/">
          <span class="logo-mark">AB</span>
          <span>Ali Bahadoran</span>
        </a>
        <a href="/">Zum Portfolio</a>
      </nav>
    </header>

    <main class="legal-content">
      <p class="section-label">Rechtliche Angaben</p>
      <h1>Impressum</h1>

      <div class="legal-card">
        <section aria-labelledby="provider-heading">
          <h2 id="provider-heading">Angaben gemäß § 5 DDG</h2>
          <address>
            Ali Bahadoran<br />
            Oschatzer Ring 6<br />
            12627 Berlin<br />
            Deutschland
          </address>
        </section>

        <section aria-labelledby="contact-heading">
          <h2 id="contact-heading">Kontakt</h2>
          <p>
            Telefon: <a href="tel:+4917670302329">+49 176 70302329</a><br />
            E-Mail: <a href="mailto:bahadoran.dev@gmail.com">bahadoran.dev@gmail.com</a>
          </p>
        </section>

        <section aria-labelledby="responsibility-heading">
          <h2 id="responsibility-heading">Inhaltlich verantwortlich</h2>
          <address> Ali Bahadoran<br />Oschatzer Ring 6<br />12627 Berlin </address>
        </section>
      </div>
    </main>

    <Footer />
  </body>
</html>
