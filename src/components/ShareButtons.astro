---
interface Props {
  title: string;
}

const { title } = Astro.props;
const shareUrl = Astro.url.toString();
const encodedUrl = encodeURIComponent(shareUrl);
const encodedTitle = encodeURIComponent(title);
---

<div class="share-buttons">
  <p class="share-buttons-label">Teilen</p>

  <a
    class="share-button"
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Auf LinkedIn teilen"
  >
    in
  </a>

  <a
    class="share-button"
    href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Auf X teilen"
  >
    𝕏
  </a>

  <a class="share-button" href={`mailto:?subject=${encodedTitle}&body=${encodedUrl}`} aria-label="Per E-Mail teilen">
    ✉
  </a>

  <button class="share-button" type="button" data-share-copy aria-label="Link kopieren">🔗</button>

  <button class="share-button" type="button" data-share-native aria-label="Teilen" hidden>⤴</button>
</div>

<script src="../scripts/share.js"></script>
