---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Screenshot {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  screenshots: Screenshot[];
}

const { screenshots } = Astro.props;

const fullImages = await Promise.all(
  screenshots.map((shot) => getImage({ src: shot.src, width: 1600, format: "webp" })),
);
---

{
  screenshots.length > 0 && (
    <section class="gallery-section" aria-labelledby="gallery-heading">
      <p class="section-label" id="gallery-heading">
        Galerie
      </p>
      <ul class="gallery-grid">
        {screenshots.map((shot, index) => (
          <li>
            <button
              type="button"
              class="gallery-item"
              data-full-src={fullImages[index].src}
              data-alt={shot.alt}
              data-caption={shot.caption ?? ""}
              aria-label={`${shot.alt} vergrößern`}
            >
              <Image src={shot.src} alt={shot.alt} width={480} height={360} loading="lazy" />
            </button>
          </li>
        ))}
      </ul>

      <div class="lightbox">
        <button type="button" class="lightbox-close" aria-label="Schließen">
          ✕
        </button>
        <button type="button" class="lightbox-prev" aria-label="Vorheriges Bild">
          ‹
        </button>
        <figure>
          <img src="" alt="" />
          <figcaption />
        </figure>
        <button type="button" class="lightbox-next" aria-label="Nächstes Bild">
          ›
        </button>
      </div>

      <script src="../scripts/lightbox.js" />
    </section>
  )
}
