---
import type { CollectionEntry } from "astro:content";

interface Props {
  prev?: CollectionEntry<"projects">;
  next?: CollectionEntry<"projects">;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="project-pager" aria-label="Projekt-Navigation">
      {prev ? (
        <a class="project-pager-link is-prev" href={`/projects/${prev.id}`}>
          <span class="project-pager-label">← Vorheriges Projekt</span>
          <span class="project-pager-title">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )}

      {next ? (
        <a class="project-pager-link is-next" href={`/projects/${next.id}`}>
          <span class="project-pager-label">Nächstes Projekt →</span>
          <span class="project-pager-title">{next.data.title}</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
